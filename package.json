{
  "name": "metronome-app",
  "version": "1.0.0",
  "private": true,
  "description": "A simple, accurate metronome with a tuner and voice control",
  "scripts": {
    "copy-web": "node scripts/copy-web.mjs",
    "build": "npm run copy-web",
    "sync": "npm run build && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^6.0.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
